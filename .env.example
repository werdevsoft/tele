# One-time setup key: typed once on first run to create the admin account (then not used for sign-in)
APP_PASSWORD=change-me
# Long random string; encrypts API hashes + Telegram sessions at rest and signs the login cookie
APP_SECRET=generate-with-openssl-rand-hex-32
# Postgres (Neon / Supabase / Vercel Postgres): stores accounts (encrypted) and the message archive.
# Leave empty locally: accounts go to .data/store.json and the archive is off.
DATABASE_URL=
# Secret Vercel Cron sends as "Authorization: Bearer ..." to /api/cron/sync
CRON_SECRET=
